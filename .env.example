# ============================================================================
# HEALTHBOX - Multi-Tenant Healthcare ERP Configuration
# ============================================================================
# Copy this to .env and configure with your values

# DATABASE ===================================================================
DATABASE_URL=jdbc:postgresql://localhost:5432/hms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT =========================================================================
JWT_SECRET=9hklsjSTS+3sH5UY5y6zsc81TEuJTsWxZfaQOC5dz2o=
JWT_EXPIRATION=86400000

# FRONTEND ====================================================================
# Must match your deployed frontend URL(s) for CORS
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# SERVER ======================================================================
PORT=8080

# Set true only when a keystore is mounted into the backend container.
# Normally terminate HTTPS at a reverse proxy/load balancer instead.
SSL_ENABLED=false
SSL_KEYSTORE_PATH=/app/keystore.jks
SSL_KEYSTORE_PASSWORD=

# SMTP (Email OTP) ============================================================
# For Gmail: use App Password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# RAZORPAY (Payments) =========================================================
# Get keys from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PLATFORM ====================================================================
# Platform fee kept out of every transaction, in paise (75 = ₹0.75)
PLATFORM_FEE_PAISE=75

# SUPER ADMIN (Bootstrap) =====================================================
# On first startup, if these are set, a SUPER_ADMIN user is created
# Leave blank to skip auto-creation
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=SecurePassword123!
SUPERADMIN_EMAIL=admin@healthboxd.io
SUPERADMIN_PHNO=+919999999999
